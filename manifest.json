{
  "manifest_version": 3,
  "name": "TabMarks",
  "version": "1.1.0",
  "description": "Color, label and annotate individual tabs with emojis, icons and notes. Built for PR-heavy dev workflows.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TabMarks",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "scripting",
    "favicon",
    "sessions",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open TabMarks (quick label)"
    },
    "cycle-color": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Mark tab / cycle through colors"
    },
    "next-marked": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Jump to next marked tab (same color if this tab is marked)"
    },
    "toggle-note": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Show / hide this tab's note on the page (opens an empty note if none)"
    },
    "remove-mark": {
      "description": "Remove color and label from this tab"
    },
    "cycle-pr-status": {
      "description": "Cycle pull request status label"
    }
  }
}
